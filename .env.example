# Copy to .env and adjust. Never commit .env.
DJANGO_SECRET_KEY=change-me-dev-only
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,web
DATABASE_URL=postgres://ticketing:ticketing@db:5432/ticketing
# Host port for Postgres (5432 is often taken by a local install)
DB_HOST_PORT=5433
DB_CONN_MAX_AGE=60
WEB_CONCURRENCY=4
WORKER_CONCURRENCY=8

# Inventory / payments
HOLD_MINUTES=10
PAYMENT_GRACE_MINUTES=15
PAYMENT_WEBHOOK_SECRET=whsec_dev_change_me
# Where the fake provider delivers webhooks (the web service inside compose)
FAKE_PROVIDER_WEBHOOK_URL=http://web:8000/api/webhooks/payments/
FAKE_PROVIDER_DELAY_SECONDS=30

# Observability
LOG_LEVEL=INFO
LOG_JSON=1
# Leave empty to disable error reporting (off by default)
SENTRY_DSN=
SENTRY_ENVIRONMENT=dev
